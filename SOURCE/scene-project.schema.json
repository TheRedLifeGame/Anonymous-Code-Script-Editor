{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ac-scene-project.schema.json",
  "title": "ANONYMOUS;CODE fan-scene project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "voiceCharacters", "launchAlias", "scenes", "injections"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "metadata": {
      "type": "object",
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "continuity": { "type": "string" }
      }
    },
    "voiceCharacters": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "launchAlias": {
      "type": "object",
      "required": ["storage", "sourceScene", "internalHash"],
      "properties": {
        "storage": { "type": "string", "pattern": "\\.ks$" },
        "sourceScene": { "type": "string" },
        "internalHash": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "injections": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/edgeInjection" },
          { "$ref": "#/$defs/afterLineInjection" }
        ]
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "target"],
      "properties": {
        "storage": { "type": "string", "pattern": "\\.ks$" },
        "target": { "type": "string", "pattern": "^\\*" },
        "mode": { "type": "string", "enum": ["native", "blank"] }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "text"],
      "properties": {
        "speaker": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "voiceId": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "window": { "type": "string", "enum": ["dialogue", "narration"] }
      }
    },
    "characterPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "position": { "type": "string" },
        "show": { "type": "boolean" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "order": { "type": "integer" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string" },
        "music": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "hideUnlisted": { "type": "boolean" },
        "speakerFocus": { "type": "boolean" },
        "speakerGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/characterPresentation" }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "template", "pages"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "title": { "type": "string" },
        "template": { "$ref": "#/$defs/edge" },
        "forkSource": {
          "type": "object",
          "description": "Editor metadata containing a read-only snapshot of the native scene used to create this fork.",
          "additionalProperties": true
        },
        "presentation": { "$ref": "#/$defs/presentation" },
        "next": { "oneOf": [{ "$ref": "#/$defs/edge" }, { "type": "null" }] },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        }
      }
    },
    "edgeInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "source", "expectedNext", "destination"],
      "properties": {
        "kind": { "const": "edge" },
        "id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/edge" },
        "expectedNext": { "$ref": "#/$defs/edge" },
        "destination": { "$ref": "#/$defs/edge" }
      }
    },
    "lineMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "speaker": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "afterLineInjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "source", "line", "expectedNext", "destination", "resumeTarget"],
      "properties": {
        "kind": { "const": "afterLine" },
        "id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/edge" },
        "line": { "$ref": "#/$defs/lineMatch" },
        "expectedNext": { "$ref": "#/$defs/edge" },
        "destination": { "$ref": "#/$defs/edge" },
        "resumeTarget": { "type": "string", "pattern": "^\\*" }
      }
    }
  }
}
